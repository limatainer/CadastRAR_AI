rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Users ──────────────────────────────────────────────
    // Each user document is owned by its uid. The client writes
    // createdAt as serverTimestamp() at signup — rule 0 pins it.
    match /users/{uid} {
      allow read, create: if request.auth.uid == uid;
      allow update: if request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'emailVerified'
        ]);
      allow delete: if false;
    }

    // ── Posts (registered people) ──────────────────────────
    // Reads stay public (matches today's unguarded Details / Search).
    // Writes are gated: paid users forever, trial users for 7 days.
    match /posts/{postId} {
      allow get, list: if true;

      function entitled() {
        // A user is entitled when they have paid OR are still in trial.
        return get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.entitlement == 'paid'
          || request.time < get(/databases/$(database)/documents/users/$(request.auth.uid))
            .data.createdAt + duration.value(7, 'd');
      }

      allow create: if entitled();
      allow update, delete: if entitled();
    }
  }
}
