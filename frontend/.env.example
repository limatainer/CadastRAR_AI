# Firebase (public config is safe to expose)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Gemini API key (single call for AI bio generation)
VITE_GEMINI_API_KEY=

# Stripe (public — this is a payment link URL, meant to be clicked)
VITE_STRIPE_PAYMENT_LINK=

# ─── Server-side secrets (NEVER use VITE_ prefix) ───
# Set these in the Vercel dashboard or your deployment environment
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FIREBASE_SERVICE_ACCOUNT=
